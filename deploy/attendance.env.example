# ---- Storage -----------------------------------------------------------
ATT_DB_PATH=/var/lib/attendance/attendance.db

# ---- Credential encryption --------------------------------------------
# Generate with:  attendance keygen
# Upstream passwords are encrypted with this key before being written to
# disk. KEEP A COPY - without it, stored passwords cannot be decrypted and
# every connection has to be re-entered.
ATT_SECRET_KEY=

# ---- Dashboard ---------------------------------------------------------
ATT_WEB_HOST=127.0.0.1
ATT_WEB_PORT=8898
# Password for signing in to the dashboard. Set a long random string.
ATT_WEB_PASSWORD=change-me
ATT_SESSION_HOURS=12

# ---- Upstream ----------------------------------------------------------
ATT_API_BASE=https://api.etimeoffice.com/api
ATT_HTTP_TIMEOUT=60

# ---- Sync --------------------------------------------------------------
# Days of history re-pulled on each scheduled run. Re-pulling is free:
# punch inserts are idempotent.
ATT_LOOKBACK_DAYS=7
ATT_TZ_NAME=Asia/Kolkata
