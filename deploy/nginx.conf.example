# Expose the dashboard over TLS. The app binds 127.0.0.1 by default, so
# nothing reaches it except through here.
#
#   cp deploy/nginx.conf.example /etc/nginx/sites-available/sanai
#   ln -s /etc/nginx/sites-available/sanai /etc/nginx/sites-enabled/
#   certbot --nginx -d sanai.example.com
#   nginx -t && systemctl reload nginx

server {
    listen 443 ssl http2;
    server_name sanai.example.com;        # <- your hostname

    ssl_certificate     /etc/letsencrypt/live/sanai.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sanai.example.com/privkey.pem;

    # The token is the only credential. Narrow who can even reach the page.
    # allow 203.0.113.4;                  # <- your IP
    # deny all;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:8899;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name sanai.example.com;
    return 301 https://$host$request_uri;
}
