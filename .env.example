# San Arb configuration. Copy to .env and fill in. Nothing here is required for
# paper mode / scanning - only for live FYERS data and trading.

# ------------------------------------------------------------------ account ---
SANARB_CAPITAL=10000            # total capital to work with (INR)
SANARB_PER_TRADE_CAP_PCT=0.5    # max fraction of capital in one position
SANARB_RESERVE_PCT=0.05         # cash buffer kept untouched
SANARB_MAX_OPEN_POSITIONS=4

# -------------------------------------------------------------- safety mode ---
# mode: "paper" (simulate) or "live" (talk to FYERS).
SANARB_MODE=paper
# The physical live switch. Orders are blocked unless this is 1 AND mode=live.
SANARB_ARM_LIVE=0
# Thin instruments: only LIMIT orders (1 = enforce, recommended).
SANARB_FORCE_LIMIT=1

# -------------------------------------------------------------- cost model ----
SANARB_BROKERAGE_PER_ORDER=0    # FYERS delivery is ~0
SANARB_ROUNDTRIP_COST_PCT=0.004 # STT+exchange+GST+stamp, round trip, approx
SANARB_SLIPPAGE_PCT=0.002

# --------------------------------------------------------- strategy knobs -----
SANARB_ETF_DISCOUNT_ENTRY=0.015 # buy an intl ETF only >1.5% below fair value
SANARB_ETF_PREMIUM_WARN=0.08    # warn/harvest above +8% premium
SANARB_SGB_DISCOUNT_ENTRY=0.02  # buy an SGB >2% below gold fair value

# ------------------------------------------------------------- liquidity ------
SANARB_MAX_SPREAD_PCT=0.01      # reject if quoted spread wider than 1%
SANARB_MAX_BOOK_PARTICIPATION=0.25

# ------------------------------------------------------------------- gold -----
# SGB fair value uses domestic 999 gold, derived from the near-month MCX gold
# future on FYERS (auto-resolved, rolls monthly). Tracks IBJA 999 to ~0.1%.
SANARB_GOLD_PRICE=0             # >0 to hard-set 999 price/gram and skip MCX
SANARB_GOLD_SYMBOL=            # e.g. MCX:GOLDM26DECFUT to pin a contract
SANARB_GOLD_ROOT=GOLDM         # GOLDM (10g, liquid) | GOLD | GOLDPETAL (1g)
SANARB_GOLD_GRAMS_PER_QUOTE=10 # 10 for GOLD/GOLDM, 1 for GOLDPETAL
SANARB_GOLD_PURITY_FACTOR=1.004020  # 999/995: MCX gold is 995, IBJA ref is 999
SANARB_GOLD_BASIS_ADJ=0        # optional haircut for futures premium over spot

# ----------------------------------------------------------------- engine -----
SANARB_SCAN_INTERVAL_SEC=60
SANARB_DATA_DIR=.sanarb

# ------------------------------------------------------- FYERS credentials ----
# From https://myapi.fyers.in/ - app must be registered under the SEBI
# retail-algo framework to place orders (data access does not require it).
FYERS_CLIENT_ID=               # e.g. ABCD1234-100
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=            # must match the app's configured redirect
FYERS_ACCESS_TOKEN=           # from `sanarb auth-token <auth_code>`; expires daily
