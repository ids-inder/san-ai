# ---- Brain -------------------------------------------------------------
SANAI_PROVIDER=anthropic              # anthropic | ollama
ANTHROPIC_API_KEY=sk-ant-...
SANAI_MODEL=claude-opus-5-5           # routine reasoning
SANAI_DEEP_MODEL=claude-opus-5-5      # distillation + grading
SANAI_EFFORT=high                     # low|medium|high|xhigh|max

# Only needed when SANAI_PROVIDER=ollama
SANAI_OLLAMA_HOST=http://127.0.0.1:11434
SANAI_OLLAMA_MODEL=qwen2.5:14b-instruct

# ---- Autonomy ----------------------------------------------------------
# full      = execute immediately, no human in the loop  (what you asked for)
# guarded   = allowlisted commands auto-run, others queue for approval
# approval  = every plan waits for you
SANAI_AUTONOMY=full

# Blocks ONLY commands that would destroy the server San AI runs on
# (wiping /, killing its own sshd, zeroing the disk). Set false to remove
# even this. Everything else runs unattended under autonomy=full.
SANAI_INTEGRITY_GUARD=true

# ---- Learning gate -----------------------------------------------------
SANAI_MASTERY_THRESHOLD=0.85          # closed-book quiz score required to execute
SANAI_MAX_LEARN_ROUNDS=4              # re-study attempts before giving up
SANAI_QUIZ_SIZE=10

# ---- Execution ---------------------------------------------------------
SANAI_WORKDIR=/var/lib/sanai/work
SANAI_DB_PATH=/var/lib/sanai/sanai.db
SANAI_CMD_TIMEOUT=300
SANAI_MAX_ACT_ROUNDS=12
SANAI_SHELL_USER=                     # optional: run commands as this unix user

# ---- Web dashboard -----------------------------------------------------
SANAI_WEB_HOST=127.0.0.1
SANAI_WEB_PORT=8899
SANAI_WEB_TOKEN=change-me-to-a-long-random-string
